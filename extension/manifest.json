{
  "manifest_version": 3,
  "name": "AboveVTT MCP Bridge",
  "version": "0.22.0",
  "description": "Lets a local MCP server (used by Claude desktop) work with AboveVTT in your D&D Beyond campaign tab.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AboveVTT MCP Bridge",
    "default_icon": {
      "16": "icons/status/off16.png",
      "32": "icons/status/off32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/campaigns/*"
      ],
      "exclude_matches": [
        "https://www.dndbeyond.com/campaigns/join/*"
      ],
      "js": [
        "page.js",
        "presence.js",
        "scenes.js",
        "scene_config.js",
        "scene_folders.js",
        "backup.js",
        "scene_create.js",
        "settings.js",
        "settings_actions.js",
        "notes.js",
        "creatures.js",
        "tokens.js",
        "music.js",
        "characters.js",
        "fog.js",
        "copy_tokens.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dndbeyond.com/campaigns/*"
      ],
      "exclude_matches": [
        "https://www.dndbeyond.com/campaigns/join/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
