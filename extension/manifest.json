{
  "manifest_version": 3,
  "name": "AboveVTT MCP Bridge",
  "version": "0.13.0",
  "description": "Lets a local MCP server (used by Claude desktop) work with AboveVTT in your D&D Beyond campaign tab.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AboveVTT MCP Bridge"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/campaigns/*"
      ],
      "exclude_matches": [
        "https://www.dndbeyond.com/campaigns/join/*"
      ],
      "js": [
        "page.js",
        "scenes.js",
        "scene_config.js",
        "scene_folders.js",
        "backup.js",
        "scene_create.js",
        "settings.js",
        "settings_actions.js",
        "notes.js",
        "creatures.js",
        "tokens.js",
        "music.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dndbeyond.com/campaigns/*"
      ],
      "exclude_matches": [
        "https://www.dndbeyond.com/campaigns/join/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
